{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Looper": "Data Source=looper.db"
  },
  "Looper": {
    "ClaudeCommand": "claude",
    "RunTimeoutMinutes": 30,
    "MaxConcurrentRuns": 2,
    "SchedulerPollSeconds": 10,
    "TestingActionTimeoutSeconds": 120
  }
}
